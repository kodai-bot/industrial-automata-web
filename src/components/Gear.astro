---
// The gear from the Industrial Automata logo, drawn in SVG so it follows the theme colour.
interface Props { size?: number; class?: string }
const { size = 32, class: className } = Astro.props;
---
<svg class:list={["gear", className]} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"
  width={size} height={size} aria-hidden="true">
  <circle cx="50" cy="50" r="33" fill="none" stroke-width="12" />
  <g>
    <rect x="44" y="4" width="12" height="14" transform="rotate(0 50 50)" />
    <rect x="44" y="4" width="12" height="14" transform="rotate(30 50 50)" />
    <rect x="44" y="4" width="12" height="14" transform="rotate(60 50 50)" />
    <rect x="44" y="4" width="12" height="14" transform="rotate(90 50 50)" />
    <rect x="44" y="4" width="12" height="14" transform="rotate(120 50 50)" />
    <rect x="44" y="4" width="12" height="14" transform="rotate(150 50 50)" />
    <rect x="44" y="4" width="12" height="14" transform="rotate(180 50 50)" />
    <rect x="44" y="4" width="12" height="14" transform="rotate(210 50 50)" />
    <rect x="44" y="4" width="12" height="14" transform="rotate(240 50 50)" />
    <rect x="44" y="4" width="12" height="14" transform="rotate(270 50 50)" />
    <rect x="44" y="4" width="12" height="14" transform="rotate(300 50 50)" />
    <rect x="44" y="4" width="12" height="14" transform="rotate(330 50 50)" />
  </g>
</svg>
