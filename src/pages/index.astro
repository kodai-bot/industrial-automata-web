---
import Base from '../layouts/Base.astro';
import Gear from '../components/Gear.astro';
import { SITE } from '../site';
---
<Base>
  <section class="wrap hero">
    <div>
      <p class="eyebrow">Technical advisory · {SITE.location}</p>
      <h1>Systems that stay maintainable.</h1>
      <p>{SITE.tagline}</p>
      <div class="actions">
        <a class="button primary" href="/consulting/">Consulting services</a>
        <a class="button" href="/contact/">Get in touch</a>
      </div>
    </div>
    <Gear size={288} />
  </section>

  <section class="wrap cards" aria-label="What we do">
    <div class="card">
      <h2>Consulting</h2>
      <p>Independent advice on technology, data, automation and AI. It starts from the problem, not the product.</p>
      <a href="/consulting/">Services →</a>
    </div>
    <div class="card">
      <h2>Research</h2>
      <p>Long-term work on robotics for archaeology: field data capture, provenance and machines that can be repaired.</p>
      <a href="/research/">Direction →</a>
    </div>
    <div class="card">
      <h2>Notes</h2>
      <p>Working notes on projects, methods and the tools behind them.</p>
      <a href="/notes/">Read →</a>
    </div>
  </section>
</Base>
