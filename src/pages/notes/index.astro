---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---
<Base title="Notes" description="Working notes from Industrial Automata.">
  <article class="wrap">
    <div class="prose">
      <h1>Notes</h1>
      <p class="lede">Working notes on projects, methods and tools.</p>
      <ul class="note-list">
        {notes.map((note) => (
          <li>
            <time datetime={note.data.date.toISOString()}>{note.data.date.toISOString().slice(0, 10)}</time>
            <a href={`/notes/${note.id}/`}>{note.data.title}</a>
            {note.data.description && <p>{note.data.description}</p>}
          </li>
        ))}
      </ul>
    </div>
  </article>
</Base>
