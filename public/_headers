# Response headers for the certified-assets canister (Netlify _headers syntax).
# The canister adds no security headers by default; these are the site's baseline.
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Astro's fingerprinted build assets never change, so cache them hard.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# HTML revalidates so new deploys show up immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
